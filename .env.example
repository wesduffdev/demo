# Buyer's Desk — environment variable template (BD-003).
#
# Copy this file to `.env` and fill in real values there. `.env` is already
# gitignored (see .gitignore) — NEVER commit real credentials, and never
# replace the placeholders below with real values in this checked-in file.
#
# These are read by `buyers_desk/config.py` via `os.environ` (no `.env`
# parser dependency — populate the process environment however your shell,
# CI, or secrets manager does that; see .claude/rules/security-secrets.md).

# ── Fulfil (ERP system of record) — required ──────────────────────────────
# Fulfil REST API key. Read-only extraction by default (external-services
# rule); a write/mutation call requires explicit human approval.
FULFIL_API_KEY=your-fulfil-api-key-here
# Your Fulfil account subdomain, e.g. "acme" for https://acme.fulfil.io
FULFIL_SUBDOMAIN=your-fulfil-subdomain-here

# ── Fulfil — optional ──────────────────────────────────────────────────────
# Override the subdomain-derived base URL (e.g. to point at a sandbox).
# Leave unset to default to https://<FULFIL_SUBDOMAIN>.fulfil.io
# FULFIL_BASE_URL=https://your-fulfil-subdomain-here.fulfil.io

# ── SharePoint (publish target, via Microsoft Graph) — required ───────────
SHAREPOINT_TENANT_ID=00000000-0000-0000-0000-000000000000
SHAREPOINT_CLIENT_ID=00000000-0000-0000-0000-000000000000
SHAREPOINT_CLIENT_SECRET=your-sharepoint-client-secret-here
# The target SharePoint site's Graph site id.
SHAREPOINT_SITE_ID=your-sharepoint-site-id-here

# ── SharePoint — optional ───────────────────────────────────────────────────
# The document library (drive) to publish reports into, if the site has more
# than one. Leave unset to use the site's default drive.
# SHAREPOINT_DRIVE_ID=your-sharepoint-drive-id-here
